ARG PHP_VERSION=8.2

# Bookworm is the shared glibc baseline published for every supported PHP 8
# minor. Pinning it avoids silently raising the required glibc with `fpm`.
FROM php:${PHP_VERSION}-fpm-bookworm AS builder

ARG RUST_VERSION=1.97.1
ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/root/.cargo/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        $PHPIZE_DEPS \
        ca-certificates \
        curl \
        libclang-dev \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
        https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}"

WORKDIR /usr/src/otel
COPY otel/ ./

# ALLOCATOR=system (default) or ALLOCATOR=mimalloc; see README "Allocator".
ARG ALLOCATOR=system
RUN cargo build --release --locked $( [ "${ALLOCATOR}" = mimalloc ] && printf -- '--features mimalloc' ) \
    && cp target/release/libotel.so /tmp/otel.so \
    && php -n -d extension=/tmp/otel.so --ri otel

# Bare artifact stage for CI: `docker buildx build --target artifact --output type=local`.
FROM scratch AS artifact
COPY --from=builder /tmp/otel.so /otel.so

FROM php:${PHP_VERSION}-fpm-bookworm

COPY --from=builder /tmp/otel.so /usr/local/lib/php/extensions/otel.so

RUN php -n -d extension=/usr/local/lib/php/extensions/otel.so --ri otel

ENTRYPOINT ["php"]
CMD ["-n", "-d", "extension=/usr/local/lib/php/extensions/otel.so", "--ri", "otel"]
