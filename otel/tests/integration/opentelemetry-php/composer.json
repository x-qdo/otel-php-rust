        "open-telemetry/transport-grpc": "^1.2.0",
        "php-http/guzzle7-adapter": "^1.1"
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.2.32"
        },
        "sort-packages": true
    }
