{
    "name": "otel-php-rust/opentelemetry-php-benchmark",
    "description": "Locked official OpenTelemetry PHP reference for the runtime benchmark",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "open-telemetry/exporter-otlp": "^1.4.0",
